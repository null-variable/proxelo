{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AccessLogPolicy": {
      "type": "object",
      "description": "AccessLogPolicy is nginx access_log with log_format. One applies: the closest to the route.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "False turns logging off for the routes it applies to.",
          "x-nullable": true
        },
        "escapeJson": {
          "type": "boolean",
          "description": "Escape values for JSON; implied by format \"json\"."
        },
        "format": {
          "type": "string",
          "description": "\"combined\" (default), \"main\", \"json\", or a template with nginx variables."
        },
        "path": {
          "type": "string",
          "description": "\"stdout\", \"stderr\" or an absolute file path."
        }
      },
      "x-order": [
        "path",
        "format",
        "escapeJson",
        "enabled"
      ],
      "required": [
        "path"
      ]
    },
    "Action": {
      "type": "object",
      "description": "Action carries the settings for Type and nothing else.",
      "properties": {
        "proxy": {
          "$ref": "#/$defs/ProxyAction",
          "x-nullable": true
        },
        "return": {
          "$ref": "#/$defs/ReturnAction",
          "x-nullable": true
        },
        "static": {
          "$ref": "#/$defs/StaticAction",
          "x-nullable": true
        },
        "type": {
          "type": "string",
          "enum": [
            "static",
            "proxy",
            "return"
          ]
        }
      },
      "x-order": [
        "type",
        "static",
        "proxy",
        "return"
      ],
      "required": [
        "type"
      ]
    },
    "Balancing": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "description": "Empty: round_robin.",
          "enum": [
            "round_robin",
            "least_conn",
            "ip_hash",
            "hash",
            "hash_consistent",
            "random",
            "random_two"
          ]
        },
        "key": {
          "type": "string",
          "description": "hash and hash_consistent: the key, with variables, such as \"$request_uri\"."
        }
      },
      "x-order": [
        "algorithm",
        "key"
      ]
    },
    "BandwidthPolicy": {
      "type": "object",
      "description": "BandwidthPolicy is nginx limit_rate and limit_rate_after: the response body rate of each request. The closest policy applies.",
      "properties": {
        "after": {
          "type": "string",
          "description": "Sent at full speed first, such as \"500k\"."
        },
        "rate": {
          "type": "string",
          "description": "Such as \"100k\" or \"1m\" bytes per second."
        }
      },
      "x-order": [
        "rate",
        "after"
      ],
      "required": [
        "rate"
      ]
    },
    "BasicAuthPolicy": {
      "type": "object",
      "description": "BasicAuthPolicy is nginx auth_basic with the users inline. The closest policy applies.",
      "properties": {
        "realm": {
          "type": "string"
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BasicUser"
          }
        }
      },
      "x-order": [
        "realm",
        "users"
      ],
      "required": [
        "realm",
        "users"
      ]
    },
    "BasicUser": {
      "type": "object",
      "properties": {
        "hash": {
          "type": "string",
          "description": "A hash as htpasswd or openssl passwd makes: bcrypt, $apr1$, $1$, $5$, $6$, {SHA} or {SSHA}."
        },
        "name": {
          "type": "string"
        }
      },
      "x-order": [
        "name",
        "hash"
      ],
      "required": [
        "name",
        "hash"
      ]
    },
    "CertStatus": {
      "type": "object",
      "description": "CertStatus is what the control plane read from the chain, or the last issuance error.",
      "properties": {
        "dnsNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        },
        "notAfter": {
          "type": "string",
          "format": "date-time"
        },
        "subject": {
          "type": "string"
        }
      },
      "x-order": [
        "subject",
        "dnsNames",
        "notAfter",
        "error"
      ]
    },
    "CertificateSpec": {
      "type": "object",
      "properties": {
        "chainPem": {
          "type": "string",
          "description": "PEM, leaf first. For acme, filled in when issued."
        },
        "domains": {
          "type": "array",
          "description": "For acme: the names to issue for.",
          "items": {
            "type": "string"
          }
        },
        "keyPem": {
          "type": "string",
          "description": "PEM private key. Never returned by the API."
        },
        "source": {
          "type": "string",
          "description": "\"upload\" (default) or \"acme\".",
          "enum": [
            "upload",
            "acme"
          ]
        },
        "status": {
          "$ref": "#/$defs/CertStatus",
          "description": "Set by the control plane.",
          "readOnly": true
        }
      },
      "x-order": [
        "source",
        "chainPem",
        "keyPem",
        "domains",
        "status"
      ]
    },
    "CompressionPolicy": {
      "type": "object",
      "description": "CompressionPolicy is nginx gzip, gzip_static and gunzip, plus brotli and zstd. The closest policy applies.",
      "properties": {
        "brotliLevel": {
          "type": "integer",
          "minimum": 0,
          "x-nullable": true
        },
        "disable": {
          "type": "string",
          "description": "PCRE2 pattern; clients whose User-Agent matches get plain responses (nginx gzip_disable)."
        },
        "encodings": {
          "type": "array",
          "description": "Dynamic encodings in order of preference: \"gzip\", \"br\", \"zstd\". The first one the client accepts is used. Empty: none, only static and gunzip apply.",
          "items": {
            "type": "string"
          }
        },
        "gunzip": {
          "type": "boolean",
          "description": "Decode gzip responses for clients that do not accept gzip (nginx gunzip)."
        },
        "gzipLevel": {
          "type": "integer",
          "description": "gzip 1-9 (default 1), br 0-11 (default 6), zstd 1-22 (default 3).",
          "minimum": 0
        },
        "http10": {
          "type": "boolean",
          "description": "Also encode for HTTP/1.0 clients (nginx gzip_http_version 1.0)."
        },
        "minLength": {
          "type": "string",
          "description": "Responses shorter than this are sent as is, such as \"1k\" (nginx gzip_min_length). Empty: 20 bytes."
        },
        "proxied": {
          "type": "array",
          "description": "Encode responses to requests with Via when one of these holds (nginx gzip_proxied): \"expired\", \"no-cache\", \"no-store\", \"private\", \"no_last_modified\", \"no_etag\", \"auth\", \"any\". Empty: never.",
          "items": {
            "type": "string"
          }
        },
        "static": {
          "type": "string",
          "description": "Serve file.gz next to a static file: \"on\" to clients that accept gzip, \"always\" to all (nginx gzip_static)."
        },
        "types": {
          "type": "array",
          "description": "Media types encoded besides text/html, or \"*\" for any (nginx gzip_types).",
          "items": {
            "type": "string"
          }
        },
        "vary": {
          "type": "boolean",
          "description": "Send Vary: Accept-Encoding (nginx gzip_vary)."
        },
        "zstdLevel": {
          "type": "integer",
          "minimum": 0
        }
      },
      "x-order": [
        "encodings",
        "types",
        "minLength",
        "gzipLevel",
        "brotliLevel",
        "zstdLevel",
        "proxied",
        "vary",
        "static",
        "gunzip",
        "http10",
        "disable"
      ]
    },
    "ConnLimitPolicy": {
      "type": "object",
      "description": "ConnLimitPolicy is nginx limit_conn_zone with limit_conn: requests in progress per key.",
      "properties": {
        "dryRun": {
          "type": "boolean"
        },
        "key": {
          "type": "string",
          "description": "Template for the key, \"$binary_remote_addr\" by default."
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "maxKeys": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "integer",
          "description": "Status for rejected requests, 503 by default.",
          "minimum": 0
        }
      },
      "x-order": [
        "key",
        "max",
        "status",
        "dryRun",
        "maxKeys"
      ],
      "required": [
        "max"
      ]
    },
    "ErrorPage": {
      "type": "object",
      "description": "ErrorPage is nginx error_page. Exactly one of URI and Route is set.",
      "properties": {
        "codes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "route": {
          "type": "string",
          "description": "Route ID handling the error like an nginx named location (@name); its path match is not used.",
          "x-ref": "routes"
        },
        "status": {
          "type": "integer",
          "description": "Nil keeps the original code, 0 takes the redirected request's status (nginx \"error_page 404 = /x\"), anything else replaces the code.",
          "minimum": 0,
          "x-nullable": true
        },
        "uri": {
          "type": "string",
          "description": "Path for an internal redirect, or an absolute http(s) URL for a redirect."
        }
      },
      "x-order": [
        "codes",
        "uri",
        "route",
        "status"
      ],
      "required": [
        "codes"
      ]
    },
    "ForwardAuthPolicy": {
      "type": "object",
      "description": "ForwardAuthPolicy is nginx auth_request: an upstream decides whether to serve each request. It gets a GET with the request headers and X-Forwarded-Method, -Proto, -Host and -Uri; 2xx allows, 401 and 403 are sent to the client, anything else is a 500. The closest policy applies.",
      "properties": {
        "copyHeaders": {
          "type": "array",
          "description": "Response headers of a successful check added to the request sent upstream; also variables $auth_resp_<name>.",
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string",
          "description": "Default 60s."
        },
        "upstream": {
          "type": "string",
          "x-ref": "upstreams"
        },
        "uri": {
          "type": "string",
          "description": "Path and query of the check, a template. Default \"/\"."
        }
      },
      "x-order": [
        "upstream",
        "uri",
        "timeout",
        "copyHeaders"
      ],
      "required": [
        "upstream"
      ]
    },
    "GeoEntry": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "description": "CIDR or address."
        },
        "value": {
          "type": "string"
        }
      },
      "x-order": [
        "network",
        "value"
      ],
      "required": [
        "network",
        "value"
      ]
    },
    "GeoTable": {
      "type": "object",
      "description": "GeoTable is nginx geo: the longest network that contains the address wins.",
      "properties": {
        "default": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GeoEntry"
          }
        }
      },
      "x-order": [
        "entries",
        "default"
      ],
      "required": [
        "entries"
      ]
    },
    "HeaderOps": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "description": "Added alongside existing headers of the same name.",
          "items": {
            "$ref": "#/$defs/HeaderValue"
          }
        },
        "always": {
          "type": "boolean",
          "description": "Response headers only: send with every status (nginx always)."
        },
        "remove": {
          "type": "array",
          "description": "Names to drop.",
          "items": {
            "type": "string"
          }
        },
        "set": {
          "type": "object",
          "description": "Header name to value template; replaces headers with that name. On responses, sent only with success and redirect statuses unless Always.",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "x-order": [
        "set",
        "add",
        "remove",
        "always"
      ]
    },
    "HeaderValue": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "x-order": [
        "name",
        "value"
      ],
      "required": [
        "name",
        "value"
      ]
    },
    "HeadersPolicy": {
      "type": "object",
      "description": "HeadersPolicy replaces nginx add_header, proxy_set_header and proxy_hide_header. Several headers policies merge by header name, the closer one winning.",
      "properties": {
        "request": {
          "$ref": "#/$defs/HeaderOps",
          "description": "Headers of the request sent upstream."
        },
        "response": {
          "$ref": "#/$defs/HeaderOps"
        }
      },
      "x-order": [
        "response",
        "request"
      ]
    },
    "HealthCheck": {
      "type": "object",
      "description": "HealthCheck probes every target; a target failing `fails` probes in a row takes no requests until it passes `passes` in a row.",
      "properties": {
        "body": {
          "type": "string",
          "description": "PCRE2 pattern the response body must match."
        },
        "fails": {
          "type": "integer",
          "description": "Zero: 1.",
          "minimum": 0
        },
        "host": {
          "type": "string",
          "description": "HTTP Host header. Empty: the upstream's name."
        },
        "interval": {
          "type": "string",
          "description": "Empty: \"5s\"."
        },
        "passes": {
          "type": "integer",
          "description": "Zero: 1.",
          "minimum": 0
        },
        "path": {
          "type": "string",
          "description": "HTTP request path. Empty: \"/\"."
        },
        "port": {
          "type": "integer",
          "description": "Probe this port instead of the target's.",
          "minimum": 0
        },
        "statuses": {
          "type": "array",
          "description": "Passing statuses such as \"200-399\" or \"204\". Empty: 200-399.",
          "items": {
            "type": "string"
          }
        },
        "timeout": {
          "type": "string",
          "description": "Per probe. Empty: \"1s\"."
        },
        "type": {
          "type": "string",
          "description": "Empty: http.",
          "enum": [
            "http",
            "tcp"
          ]
        }
      },
      "x-order": [
        "type",
        "interval",
        "timeout",
        "fails",
        "passes",
        "path",
        "host",
        "statuses",
        "body",
        "port"
      ]
    },
    "HostMatch": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exact",
            "wildcard",
            "regex"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "x-order": [
        "type",
        "value"
      ],
      "required": [
        "type",
        "value"
      ]
    },
    "IPAccessPolicy": {
      "type": "object",
      "description": "IPAccessPolicy is nginx allow and deny. Rules of all policies that apply are checked in order, outermost first; the first match decides and no match allows. A denied request gets 403.",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IPRule"
          }
        }
      },
      "x-order": [
        "rules"
      ],
      "required": [
        "rules"
      ]
    },
    "IPRule": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "\"allow\" or \"deny\"."
        },
        "from": {
          "type": "string",
          "description": "CIDR, address, or \"all\"."
        }
      },
      "x-order": [
        "action",
        "from"
      ],
      "required": [
        "action",
        "from"
      ]
    },
    "Keepalive": {
      "type": "object",
      "properties": {
        "idle": {
          "type": "integer",
          "description": "Idle connections kept per worker (nginx keepalive).",
          "minimum": 0
        },
        "maxAge": {
          "type": "string",
          "description": "A connection closes after being open this long (nginx keepalive_time). Empty: \"1h\"."
        },
        "maxRequests": {
          "type": "integer",
          "description": "Zero: 1000.",
          "minimum": 0
        },
        "timeout": {
          "type": "string",
          "description": "Empty: \"60s\"."
        }
      },
      "x-order": [
        "idle",
        "timeout",
        "maxRequests",
        "maxAge"
      ]
    },
    "ListenerSpec": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "description": "host:port, for example \"0.0.0.0:443\"."
        },
        "backlog": {
          "type": "integer",
          "minimum": 0
        },
        "defaultSite": {
          "type": "string",
          "description": "Site ID served when no hostname matches (nginx default_server).",
          "x-ref": "sites"
        },
        "http2": {
          "type": "boolean",
          "description": "Offer HTTP/2 through ALPN; requires TLS."
        },
        "reusePort": {
          "type": "boolean"
        },
        "tls": {
          "$ref": "#/$defs/ListenerTLS",
          "description": "TLS termination. Nil: plain TCP.",
          "x-nullable": true
        }
      },
      "x-order": [
        "address",
        "reusePort",
        "backlog",
        "defaultSite",
        "tls",
        "http2"
      ],
      "required": [
        "address"
      ]
    },
    "ListenerTLS": {
      "type": "object",
      "properties": {
        "ciphers": {
          "type": "string",
          "description": "OpenSSL cipher list for TLS 1.2 and below (nginx ssl_ciphers). Empty: \"HIGH:!aNULL:!MD5\"."
        },
        "defaultCertificate": {
          "type": "string",
          "description": "Certificate ID for handshakes without SNI or whose name selects a site without certificates. Empty: those handshakes fail.",
          "x-ref": "certificates"
        },
        "minVersion": {
          "type": "string",
          "description": "\"1.0\", \"1.1\", \"1.2\" or \"1.3\". Empty: \"1.2\" (nginx ssl_protocols TLSv1.2 TLSv1.3)."
        }
      },
      "x-order": [
        "defaultCertificate",
        "minVersion",
        "ciphers"
      ]
    },
    "LookupSpec": {
      "type": "object",
      "description": "LookupSpec carries the table for Type and nothing else.",
      "properties": {
        "geo": {
          "$ref": "#/$defs/GeoTable",
          "x-nullable": true
        },
        "map": {
          "$ref": "#/$defs/MapTable",
          "x-nullable": true
        },
        "source": {
          "type": "string",
          "description": "Template looked up, such as \"$http_user_agent\". geo: an address, $remote_addr when empty."
        },
        "split": {
          "$ref": "#/$defs/SplitClients",
          "x-nullable": true
        },
        "type": {
          "type": "string",
          "enum": [
            "map",
            "geo",
            "split"
          ]
        },
        "variable": {
          "type": "string",
          "description": "Variable name without '$': lowercase letters, digits and '_'. Empty: the resource name with '-' as '_'."
        }
      },
      "x-order": [
        "type",
        "variable",
        "source",
        "map",
        "geo",
        "split"
      ],
      "required": [
        "type"
      ]
    },
    "MapEntry": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "match": {
          "type": "string",
          "description": "Empty: exact.",
          "enum": [
            "exact",
            "regex",
            "regexCI"
          ]
        },
        "value": {
          "type": "string",
          "description": "A template; a regex's groups are $1..$9."
        }
      },
      "x-order": [
        "match",
        "key",
        "value"
      ],
      "required": [
        "key",
        "value"
      ]
    },
    "MapTable": {
      "type": "object",
      "description": "MapTable is nginx map. Exact keys compare case-insensitively and win; regexes are then tried in order.",
      "properties": {
        "default": {
          "type": "string",
          "description": "Value when nothing matches, a template. Empty: an empty value."
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MapEntry"
          }
        },
        "hostnames": {
          "type": "boolean",
          "description": "Keys may be \"*.example.com\", \".example.com\" or \"www.example.*\" (nginx map hostnames)."
        }
      },
      "x-order": [
        "entries",
        "default",
        "hostnames"
      ],
      "required": [
        "entries"
      ]
    },
    "Match": {
      "type": "object",
      "description": "Match selects requests by path (nginx location) and, optionally, by conditions checked after the path. Routes with the same path in one block are tried in order with their conditions, then the one without.",
      "properties": {
        "expr": {
          "type": "string",
          "description": "CEL expression over `request` (see proxelo.expr.v1.Request) that must be a bool, with the standard library and the network extension."
        },
        "headers": {
          "type": "array",
          "description": "Header conditions; names are case-insensitive.",
          "items": {
            "$ref": "#/$defs/ValueMatch"
          }
        },
        "methods": {
          "type": "array",
          "description": "Uppercase methods; empty allows any.",
          "items": {
            "type": "string"
          }
        },
        "path": {
          "$ref": "#/$defs/PathMatch"
        },
        "query": {
          "type": "array",
          "description": "Query argument conditions; names are case-sensitive.",
          "items": {
            "$ref": "#/$defs/ValueMatch"
          }
        }
      },
      "x-order": [
        "path",
        "methods",
        "headers",
        "query",
        "expr"
      ],
      "required": [
        "path"
      ]
    },
    "PassiveHealth": {
      "type": "object",
      "description": "PassiveHealth is nginx max_fails and fail_timeout.",
      "properties": {
        "failTimeout": {
          "type": "string",
          "description": "Empty: \"10s\"."
        },
        "maxFails": {
          "type": "integer",
          "description": "Nil: 1. Zero disables it.",
          "minimum": 0,
          "x-nullable": true
        }
      },
      "x-order": [
        "maxFails",
        "failTimeout"
      ]
    },
    "PathMatch": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exact",
            "prefix",
            "prefixPriority",
            "regex",
            "regexCI"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "x-order": [
        "type",
        "value"
      ],
      "required": [
        "type",
        "value"
      ]
    },
    "PolicySpec": {
      "type": "object",
      "description": "PolicySpec carries the settings for Type and nothing else.",
      "properties": {
        "accessLog": {
          "$ref": "#/$defs/AccessLogPolicy",
          "x-nullable": true
        },
        "bandwidth": {
